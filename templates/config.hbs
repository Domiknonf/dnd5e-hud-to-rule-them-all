{{!-- Per-actor HUD configuration. The application's tag is <form>, so everything
     below already sits inside it - the submit button needs no form attribute.
     Note what is NOT a form field: the zones save on every drop, which is why
     #onSubmit has to carry `entries` across by hand. --}}
<div class="hudtra-config-body">

  {{!-- Left column: every actor this user may configure. A player sees their own
       characters, the GM sees the whole encounter plus the party. --}}
  <nav class="hudtra-config-actors">
    {{#each actors}}
    <button type="button" class="hudtra-config-actor {{#if selected}}selected{{/if}}"
            data-action="pickActor" data-actor-uuid="{{uuid}}">
      <img src="{{img}}" alt="">
      <span>{{name}}</span>
      {{#if notice}}<i class="hudtra-config-mark fa-solid fa-circle-exclamation"></i>{{/if}}
    </button>
    {{else}}
    <p class="hudtra-config-empty">{{localize "dnd5e-hud-to-rule-them-all.config.noActors"}}</p>
    {{/each}}
  </nav>

  <section class="hudtra-config-panel">
    {{#if actor}}
    <h3 class="hudtra-config-heading">{{actor.name}}</h3>

    {{!-- Raised when detection disagrees with the configured count, typically after
         a level-up. Two explicit outs, no silent rewrite: take the number, or keep
         yours and never hear about THIS number again. --}}
    {{#if notice}}
    <div class="hudtra-config-notice">
      <i class="fa-solid fa-circle-exclamation"></i>
      <div class="hudtra-config-notice-text">
        <strong>{{localize "dnd5e-hud-to-rule-them-all.config.notice.title"}}</strong>
        <p>{{notice.body}}</p>
      </div>
      <div class="hudtra-config-notice-buttons">
        <button type="button" data-action="applyNotice">
          <i class="fa-solid fa-check"></i> {{notice.apply}}
        </button>
        <button type="button" data-action="dismissNotice">
          <i class="fa-solid fa-xmark"></i> {{notice.dismiss}}
        </button>
      </div>
    </div>
    {{/if}}

    <div class="hudtra-config-numbers">
      <div class="form-group">
        <label for="hudtra-cfg-attacks">
          {{localize "dnd5e-hud-to-rule-them-all.config.attacksPerAction.name"}}
        </label>
        <div class="form-fields">
          <input type="number" id="hudtra-cfg-attacks" name="attacksPerAction"
                 min="{{limits.attacksPerAction.min}}" max="{{limits.attacksPerAction.max}}" step="1"
                 value="{{attacksPerAction}}" placeholder="{{attacksPlaceholder}}">
        </div>
        <p class="hint">{{attacksHint}}</p>
      </div>

      <fieldset class="hudtra-config-pools">
        <legend>{{localize "dnd5e-hud-to-rule-them-all.config.pools.name"}}</legend>
        {{#each pools}}
        <div class="form-group">
          <label for="hudtra-cfg-max-{{key}}">{{label}}</label>
          <div class="form-fields">
            <input type="number" id="hudtra-cfg-max-{{key}}" name="max.{{key}}"
                   min="{{../limits.poolMax.min}}" max="{{../limits.poolMax.max}}" step="1"
                   value="{{value}}" placeholder="{{placeholder}}">
          </div>
        </div>
        {{/each}}
        <p class="hint">{{localize "dnd5e-hud-to-rule-them-all.config.pools.hint"}}</p>
      </fieldset>
    </div>

    {{!-- Multiattack: a link, plus a nudge when the statblock names several
         different attacks - exactly when one number cannot describe the creature. --}}
    <div class="hudtra-config-ma {{#if multiattack.prompt}}prompt{{/if}}">
      {{#if multiattack.prompt}}<i class="fa-solid fa-circle-exclamation"></i>{{/if}}
      <span>
        {{#if multiattack.prompt}}
        {{localize "dnd5e-hud-to-rule-them-all.multiattack.detected"}}
        {{else if multiattack.configured}}
        {{localize "dnd5e-hud-to-rule-them-all.multiattack.configured"}}
        {{else}}
        {{localize "dnd5e-hud-to-rule-them-all.multiattack.absent"}}
        {{/if}}
      </span>
      <button type="button" data-action="multiattack">
        <i class="fa-solid fa-hand-fist"></i>
        {{localize "dnd5e-hud-to-rule-them-all.multiattack.open"}}
      </button>
    </div>

    {{!-- Drop zones, seeded by detection. Drag a tile between zones, or an item
         straight off the character sheet, to overrule where it belongs; drag within
         a zone to set the order the bar shows. --}}
    <div class="hudtra-config-zones">
      <p class="hint">{{localize "dnd5e-hud-to-rule-them-all.config.zones.hint"}}</p>
      {{#each zones}}
      <section class="hudtra-zone" data-zone="{{key}}">
        <h4><i class="{{icon}}"></i> {{label}}</h4>
        <div class="hudtra-zone-tiles">
          {{#each tiles}}
          <div class="hudtra-tile {{#if overridden}}overridden{{/if}}" draggable="true" data-key="{{key}}">
            <img src="{{img}}" alt="">
            <span class="hudtra-tile-name">{{name}}{{#if detail}} <em>{{detail}}</em>{{/if}}</span>
            {{#if split}}<i class="hudtra-tile-split fa-solid fa-link-slash"
                            data-tooltip="dnd5e-hud-to-rule-them-all.config.zones.splitMark"></i>{{/if}}
            <span class="hudtra-tile-tools">
              {{#if showAttack}}
              <button type="button" data-action="toggleAttack"
                      class="{{#if attack}}on{{/if}} {{#if attackOverridden}}set{{/if}}"
                      data-tooltip="dnd5e-hud-to-rule-them-all.config.zones.attackToggle">
                <i class="fa-solid fa-hand-fist"></i>
              </button>
              {{/if}}
              <button type="button" data-action="toggleHidden"
                      data-tooltip="dnd5e-hud-to-rule-them-all.config.zones.hideToggle">
                <i class="fa-solid {{#if hidden}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
              </button>
              {{#if overridden}}
              <button type="button" data-action="resetEntry"
                      data-tooltip="dnd5e-hud-to-rule-them-all.config.zones.resetEntry">
                <i class="fa-solid fa-rotate-left"></i>
              </button>
              {{/if}}
            </span>
          </div>
          {{else}}
          <p class="hudtra-zone-empty">{{hint}}</p>
          {{/each}}
        </div>
      </section>
      {{/each}}
    </div>

    <footer class="hudtra-config-footer">
      <button type="submit" class="hudtra-config-save">
        <i class="fa-solid fa-floppy-disk"></i>
        {{localize "dnd5e-hud-to-rule-them-all.config.save"}}
      </button>
      <button type="button" data-action="clear">
        <i class="fa-solid fa-eraser"></i>
        {{localize "dnd5e-hud-to-rule-them-all.config.clear"}}
      </button>
    </footer>
    {{/if}}
  </section>

</div>
