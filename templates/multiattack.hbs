{{!-- Multiattack editor. One "alternative" block per option; several rows inside one
     block are combined. See multiattack-app.mjs for the shape this writes. --}}
<div class="hudtra-ma-body">
  {{#if hasAttacks}}
  <p class="hint">{{localize "dnd5e-hud-to-rule-them-all.multiattack.hint"}}</p>

  <div class="hudtra-ma-options">
    {{#each options}}
    <section class="hudtra-ma-option">
      <header>
        <span>{{localize "dnd5e-hud-to-rule-them-all.multiattack.alternative"}} {{number}}</span>
        <button type="button" data-action="removeOption" data-option="{{index}}"
                data-tooltip="dnd5e-hud-to-rule-them-all.multiattack.removeOption">
          <i class="fa-solid fa-trash"></i>
        </button>
      </header>

      {{#each parts}}
      <div class="hudtra-ma-part">
        <input type="number" name="options.{{../index}}.parts.{{index}}.count"
               min="1" max="{{../../limits.attacksPerAction.max}}" step="1" value="{{count}}">
        <span class="hudtra-ma-times">&times;</span>
        <select name="options.{{../index}}.parts.{{index}}.key">
          {{#each choices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <button type="button" data-action="removePart"
                data-option="{{../index}}" data-part="{{index}}"
                data-tooltip="dnd5e-hud-to-rule-them-all.multiattack.removePart">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      {{else}}
      <p class="hudtra-ma-empty">{{localize "dnd5e-hud-to-rule-them-all.multiattack.emptyOption"}}</p>
      {{/each}}

      <button type="button" class="hudtra-ma-add-part" data-action="addPart" data-option="{{index}}">
        <i class="fa-solid fa-plus"></i>
        {{localize "dnd5e-hud-to-rule-them-all.multiattack.addPart"}}
      </button>
    </section>
    {{else}}
    <p class="hudtra-ma-empty">{{localize "dnd5e-hud-to-rule-them-all.multiattack.none"}}</p>
    {{/each}}
  </div>

  <div class="hudtra-ma-tools">
    <button type="button" data-action="addOption">
      <i class="fa-solid fa-plus"></i>
      {{localize "dnd5e-hud-to-rule-them-all.multiattack.addOption"}}
    </button>
    {{#if suggestion}}
    <button type="button" data-action="useSuggestion"
            data-tooltip="dnd5e-hud-to-rule-them-all.multiattack.suggestHint">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      {{localize "dnd5e-hud-to-rule-them-all.multiattack.suggest"}}
    </button>
    {{/if}}
    <button type="button" data-action="clearAll">
      <i class="fa-solid fa-eraser"></i>
      {{localize "dnd5e-hud-to-rule-them-all.multiattack.clear"}}
    </button>
  </div>

  <footer class="hudtra-config-footer">
    <button type="submit" class="hudtra-config-save">
      <i class="fa-solid fa-floppy-disk"></i>
      {{localize "dnd5e-hud-to-rule-them-all.config.save"}}
    </button>
  </footer>
  {{else}}
  <p class="hudtra-ma-empty">{{localize "dnd5e-hud-to-rule-them-all.multiattack.noAttacks"}}</p>
  {{/if}}
</div>
