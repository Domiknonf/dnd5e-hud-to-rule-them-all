{{!-- ApplicationV2 requires every PARTS template to render EXACTLY ONE root element,
     so this wrapper is mandatory, not cosmetic: the bar and the re-open handle are
     siblings (see the handle's own comment below), and an empty render - possible
     for a moment before refreshHUD() closes the app - still has to produce one
     element. It also spans the full width, which is what lets the handle sit in the
     viewport's corner while the frame itself stays centred. --}}
<div class="hudtra-root">
{{#if hasSubject}}
{{!-- --hudtra-scale drives the whole bar's em-based sizing (per-user "HUD scale"
     setting); --hudtra-hp-pct feeds the portrait's conic-gradient HP ring. Both are
     presentation-only context fields. --}}
<div class="hudtra-frame" style="--hudtra-scale: {{scale}}">

  {{!-- One collapse handle, rendered at the top edge of whatever is currently the
       topmost element: the description panel if open, the bar itself otherwise.
       Clicking it collapses the description first, the bar only once it's gone. --}}
  {{#if description}}
  <div class="hudtra-desc-panel">
    <button type="button" class="hudtra-collapse" data-action="collapse"
            data-tooltip-text="{{collapseTooltip}}">
      <i class="fa-solid fa-chevron-down"></i>
    </button>
    <div class="hudtra-desc-content">{{{description.content}}}</div>
  </div>
  {{else}}
  <button type="button" class="hudtra-collapse" data-action="collapse"
          data-tooltip-text="{{collapseTooltip}}">
    <i class="fa-solid fa-chevron-down"></i>
  </button>
  {{/if}}

  <div class="hudtra-main">

  <div class="hudtra-char">
    <div class="hudtra-portrait-ring {{#if isDying}}dying{{/if}}" style="--hudtra-hp-pct: {{hpPct}}">
      <button type="button" class="hudtra-portrait-btn" data-action="portrait"
              data-tooltip-text="{{portraitTooltip}}">
        <img class="hudtra-portrait" src="{{img}}" alt="{{name}}">
        {{#if isDying}}<i class="hudtra-skull fa-solid fa-skull"></i>{{/if}}
      </button>
      {{#if hp}}<span class="hudtra-hp-label">{{hp.value}}/{{hp.max}}</span>{{/if}}
    </div>
    <span class="hudtra-name">{{name}}</span>
    <span class="hudtra-vitals">
      {{#if ac}}<span class="hudtra-ac"><i class="fa-solid fa-shield"></i> {{ac}}</span>{{/if}}
      {{#if inCombat}}
      <span class="hudtra-round">{{localize "dnd5e-hud-to-rule-them-all.round"}} {{round}}</span>
      {{/if}}
    </span>
  </div>

  {{!-- Economy only exists inside an encounter AND only for a creature somebody
       plays: outside one there is no combatant to book against, and on a GM-run
       monster nothing is counted at all (see economy.isTracked). Either way, pips
       here would promise tracking that isn't happening. The groups below stay - the
       bar is still that creature's ability launcher. --}}
  {{#if showEconomy}}
  <div class="hudtra-economy">
    {{#each pools}}
    {{!-- data-action only for the GM: the handler checks again, but a control nobody
         else has must not advertise itself in everyone's tooltip either. --}}
    <div class="hudtra-pool {{#if blocked}}blocked{{/if}} {{#if coupled}}coupled{{/if}} {{#if adjustable}}adjustable{{/if}}"
         data-pool="{{key}}" {{#if adjustable}}data-action="adjustPool"{{/if}}
         data-tooltip-text="{{label}}: {{left}}/{{max}}{{#if hint}} — {{hint}}{{/if}}{{#if adjustable}}
{{localize "dnd5e-hud-to-rule-them-all.pool.adjustHint"}}{{/if}}">
      <i class="{{icon}}"></i>
      <div class="hudtra-pips">
        {{#each pips}}<span class="hudtra-pip {{#if spent}}spent{{/if}}"></span>{{/each}}
      </div>
      {{!-- Slow: these two share one budget. Said BEFORE it bites, or the Bonus
           Action just stops working with nothing to explain it. --}}
      {{#if coupled}}<i class="hudtra-coupled fa-solid fa-link"></i>{{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- data-tooltip-class/-direction are looked up on ancestors by core's
       TooltipManager, so they're declared once here for every slot. --}}
  <div class="hudtra-groups" data-tooltip-class="hudtra-tooltip" data-tooltip-direction="UP">
    {{#each groups}}
    <section class="hudtra-group {{#if exhausted}}exhausted{{/if}}" data-group="{{key}}">
      {{!-- The header is the fold control: the label folds the whole group, each chip
           one section of it. It keeps its full gold while folded and gains a count -
           it is then the only thing left of the group, so it has to say how much is
           behind it and stay the easiest thing there to hit. --}}
      <h4>
        <button type="button" class="hudtra-group-head" data-action="toggleFold"
                data-fold="{{key}}" data-tooltip-text="{{foldTooltip}}">
          <i class="hudtra-caret fa-solid {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
          <i class="{{icon}}"></i>
          <span>{{label}}</span>
          {{#if collapsed}}<span class="hudtra-count">{{count}}</span>{{/if}}
        </button>
        {{#if chips}}
        <span class="hudtra-chips">
          {{#each chips}}
          <button type="button" class="hudtra-chip {{#if collapsed}}folded{{/if}}"
                  data-action="toggleFold" data-fold="{{id}}" data-tooltip-text="{{tooltip}}">
            <i class="{{icon}}"></i>
            {{!-- The count only while folded: unfolded, the slots are right there to
                 be counted, and the chip row has to stay narrower than the grid it
                 sits above or it widens the whole group. --}}
            {{#if collapsed}}<span>{{count}}</span>{{/if}}
          </button>
          {{/each}}
        </span>
        {{/if}}
      </h4>

      {{!-- One loop, whether the group is sectioned or not: an unsectioned group is a
           single nameless section (see hud.mjs sectionsFor), which is what keeps the
           slot markup below from existing twice. --}}
      {{#unless collapsed}}
      <div class="hudtra-sections">
        {{#each sections}}
        {{#unless collapsed}}
        <div class="hudtra-entries" data-section="{{key}}">
          {{#each entries}}
          <button type="button" class="hudtra-slot {{#if locked}}locked{{/if}}" data-action="{{action}}"
                  data-kind="{{kind}}" data-uuid="{{uuid}}" data-type="{{pool}}"
                  data-name="{{name}}"
                  data-tooltip-html="{{tooltipHtml}}">
            {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="{{icon}}"></i>{{/if}}
            {{#if locked}}<i class="hudtra-lock fa-solid fa-lock"></i>{{/if}}
            {{!-- Same icon the config dialog marks a split entry with, meaning the
                 same thing: this item has buttons in more than one pool. --}}
            {{#if split}}<i class="hudtra-split fa-solid fa-link-slash"></i>{{/if}}
            {{#if uses}}<span class="hudtra-uses">{{uses.value}}/{{uses.max}}</span>{{/if}}
            {{#if attacksBadge}}<span class="hudtra-attacks"><i class="fa-solid fa-hand-fist"></i>{{attacksBadge.available}}/{{attacksBadge.max}}</span>{{/if}}
          </button>
          {{/each}}
        </div>
        {{/unless}}
        {{/each}}
      </div>
      {{/unless}}
    </section>
    {{/each}}
  </div>

  {{#if editable}}
  <div class="hudtra-controls">
    {{!-- The mark appears when detection suggests a different attack count than the
         configured one (typically after a level-up) and is cleared from inside the
         dialog. Hint only - nothing is rewritten behind the player's back. --}}
    <button type="button" class="hudtra-config-btn {{#if configNotice}}has-notice{{/if}}"
            data-action="config" data-tooltip-text="{{configTooltip}}">
      <i class="fa-solid fa-gear"></i>
      {{#if configNotice}}<i class="hudtra-config-mark fa-solid fa-exclamation"></i>{{/if}}
    </button>
    {{!-- Refilling the pools only means something where there are pools. --}}
    {{#if showEconomy}}
    <button type="button" class="hudtra-reset" data-action="reset" data-tooltip="dnd5e-hud-to-rule-them-all.resetTurn">
      <i class="fa-solid fa-rotate-left"></i>
    </button>
    {{/if}}
    {{!-- Turn control, not economy: the GM still ends a monster's turn from here.
         isMyTurn already implies being in the encounter. --}}
    {{#if isMyTurn}}
    <button type="button" class="hudtra-end-turn" data-action="endTurn" data-tooltip="dnd5e-hud-to-rule-them-all.endTurn">
      <i class="fa-solid fa-forward-step"></i>
    </button>
    {{/if}}
  </div>
  {{/if}}

  </div>

</div>

{{!-- Re-open handle for the collapsed bar. Deliberately a SECOND handle outside
     .hudtra-frame: the frame's collapse transform drags its own tab down to the
     screen edge wherever the bar happens to be centred, which is right where
     Foundry's macro bar lives. This one is positioned against the viewport's right
     corner instead, so the macro bar - visible again while the bar is away - keeps
     the middle to itself. --}}
<button type="button" class="hudtra-reopen" data-action="collapse"
        data-tooltip="dnd5e-hud-to-rule-them-all.toggleBar">
  <i class="fa-solid fa-chevron-up"></i>
</button>
{{/if}}
</div>
