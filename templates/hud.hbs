{{!-- ApplicationV2 requires every PARTS template to render EXACTLY ONE root element,
     so this wrapper is mandatory, not cosmetic: the bar and the re-open handle are
     siblings (see the handle's own comment below), and an empty render - possible
     for a moment before refreshHUD() closes the app - still has to produce one
     element. It also spans the full width, which is what lets the handle sit in the
     viewport's corner while the frame itself stays centred. --}}
<div class="hudtra-root">
{{#if hasSubject}}
{{!-- --hudtra-scale drives the whole bar's em-based sizing (per-user "HUD scale"
     setting); --hudtra-hp-pct feeds the portrait's conic-gradient HP ring. Both are
     presentation-only context fields. --}}
<div class="hudtra-frame" style="--hudtra-scale: {{scale}}">

  {{!-- The collapse handle, at the bar's top edge. Descriptions are no longer a panel
       up here: they are pinned as core tooltips beside the slot they came from (see
       hud.mjs #pinDescription), which is what the character sheet's middle click
       does, so nothing above the bar has to make room for them any more. --}}
  <button type="button" class="hudtra-collapse" data-action="collapse"
          data-tooltip="dnd5e-hud-to-rule-them-all.toggleBar">
    <i class="fa-solid fa-chevron-down"></i>
  </button>

  {{!-- Category tabs, BG3's row above the hotbar. Only for a creature somebody plays:
       a GM-run statblock keeps its pool columns, which are already the categories it
       needs. Each tab narrows the grid; the lit one clears it again. --}}
  {{#if played}}
  <div class="hudtra-tabs">
    {{#each tabs}}
    <button type="button" class="hudtra-tab {{#if active}}on{{/if}}"
            data-action="toggleCategory" data-category="{{key}}" data-tooltip-text="{{tooltip}}">
      <i class="{{icon}}"></i>
      <span>{{label}}</span>
      <span class="hudtra-tab-n">{{count}}</span>
    </button>
    {{/each}}
  </div>
  {{/if}}

  <div class="hudtra-main">

  <div class="hudtra-char">
    <div class="hudtra-portrait-ring {{#if isDying}}dying{{/if}}" style="--hudtra-hp-pct: {{hpPct}}">
      <button type="button" class="hudtra-portrait-btn" data-action="portrait"
              data-tooltip-text="{{portraitTooltip}}">
        <img class="hudtra-portrait" src="{{img}}" alt="{{name}}">
        {{#if isDying}}<i class="hudtra-skull fa-solid fa-skull"></i>{{/if}}
      </button>
      {{#if hp}}<span class="hudtra-hp-label">{{hp.value}}/{{hp.max}}</span>{{/if}}
    </div>
    <span class="hudtra-name">{{name}}</span>
    <span class="hudtra-vitals">
      {{#if ac}}<span class="hudtra-ac"><i class="fa-solid fa-shield"></i> {{ac}}</span>{{/if}}
      {{#if inCombat}}
      <span class="hudtra-round">{{localize "dnd5e-hud-to-rule-them-all.round"}} {{round}}</span>
      {{/if}}
    </span>
  </div>

  {{!-- Economy only exists inside an encounter AND only for a creature somebody
       plays: outside one there is no combatant to book against, and on a GM-run
       monster nothing is counted at all (see economy.isTracked). Either way, pips
       here would promise tracking that isn't happening. The groups below stay - the
       bar is still that creature's ability launcher. --}}
  {{#if resources}}
  <div class="hudtra-economy">
    <div class="hudtra-pools">
    {{#each pools}}
    {{!-- data-action only for the GM: the handler checks again, but a control nobody
         else has must not advertise itself in everyone's tooltip either. --}}
    <div class="hudtra-pool {{#if blocked}}blocked{{/if}} {{#if coupled}}coupled{{/if}} {{#if adjustable}}adjustable{{/if}}"
         data-pool="{{key}}" {{#if adjustable}}data-action="adjustPool"{{/if}}
         data-tooltip-text="{{label}}: {{left}}/{{max}}{{#if hint}} — {{hint}}{{/if}}{{#if adjustable}}
{{localize "dnd5e-hud-to-rule-them-all.pool.adjustHint"}}{{/if}}">
      <i class="{{icon}}"></i>
      <div class="hudtra-pips">
        {{#each pips}}<span class="hudtra-pip {{#if spent}}spent{{/if}}"></span>{{/each}}
      </div>
      {{!-- Slow: these two share one budget. Said BEFORE it bites, or the Bonus
           Action just stops working with nothing to explain it. --}}
      {{#if coupled}}<i class="hudtra-coupled fa-solid fa-link"></i>{{/if}}
    </div>
    {{/each}}
    </div>

    {{!-- Spell slots live in this column, with the other resources, rather than in a
         row of their own above the bar: they answer the same question the pips do.
         Each level also filters the bar; the lit one clears the filter again. --}}
    {{#if spellBar}}
    <div class="hudtra-spellslots">
      {{#each spellBar.levels}}
      {{!-- A readout, not a control: what you can still cast is said by the bar itself,
           which greys out what no slot can pay for. A <span>, so it never looks like a
           button that does nothing. --}}
      <span class="hudtra-level {{#if empty}}empty{{/if}}" data-tooltip-text="{{tooltip}}">
        <span class="hudtra-level-badge">{{short}}</span>
        {{!-- One pip per slot, filled while it is still there: "how many do I have
             left" without reading anything. Past SPELL_PIP_LIMIT it is a number. --}}
        {{#if pips}}
        <span class="hudtra-spell-pips">
          {{#each pips}}<span class="hudtra-spell-pip {{#if spent}}spent{{/if}}"></span>{{/each}}
        </span>
        {{/if}}
        {{#if slots}}<span class="hudtra-level-slots">{{slots}}</span>{{/if}}
      </span>
      {{/each}}
      {{!-- Pact Magic is a readout, not a filter: a pact slot casts anything you know
           at its level, so there is no set of spells it would narrow to. --}}
      {{#if spellBar.pact}}
      <span class="hudtra-level pact {{#if spellBar.pact.empty}}empty{{/if}}"
            data-tooltip-text="{{spellBar.pact.tooltip}}">
        <span class="hudtra-level-badge">{{spellBar.pact.short}}</span>
        {{#if spellBar.pact.pips}}
        <span class="hudtra-spell-pips">
          {{#each spellBar.pact.pips}}<span class="hudtra-spell-pip {{#if spent}}spent{{/if}}"></span>{{/each}}
        </span>
        {{/if}}
        {{#if spellBar.pact.slots}}<span class="hudtra-level-slots">{{spellBar.pact.slots}}</span>{{/if}}
      </span>
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- data-tooltip-class/-direction are looked up on ancestors by core's
       TooltipManager, so they're declared once here for every slot. --}}
  {{!-- Two layouts, one container. A played creature gets ONE headerless field whose
       empty slots are painted by CSS (see .hudtra-grid), so the hotbar is always a
       full rectangle at any width; a GM-run creature keeps its pool columns with their
       fold controls. --}}
  <div class="hudtra-groups {{#if played}}hudtra-grid{{/if}}" style="--hudtra-rows: {{gridRows}}"
       data-tooltip-class="hudtra-tooltip" data-tooltip-direction="UP">
    {{#each groups}}
    <section class="hudtra-group {{#if exhausted}}exhausted{{/if}}" data-group="{{key}}">
      {{#if header}}
      {{!-- The header is the fold control: the label folds the whole group, each chip
           one section of it. It keeps its full gold while folded and gains a count -
           it is then the only thing left of the group, so it has to say how much is
           behind it and stay the easiest thing there to hit. --}}
      <h4>
        <button type="button" class="hudtra-group-head" data-action="toggleFold"
                data-fold="{{key}}" data-tooltip-text="{{foldTooltip}}">
          <i class="hudtra-caret fa-solid {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
          <i class="{{icon}}"></i>
          <span>{{label}}</span>
          {{#if collapsed}}<span class="hudtra-count">{{count}}</span>{{/if}}
        </button>
        {{#if chips}}
        <span class="hudtra-chips">
          {{#each chips}}
          <button type="button" class="hudtra-chip {{#if collapsed}}folded{{/if}}"
                  data-action="toggleFold" data-fold="{{id}}" data-tooltip-text="{{tooltip}}">
            <i class="{{icon}}"></i>
            {{!-- Folded, the chip says WHAT is folded and how much of it - an icon
                 alone leaves you counting section icons to work out what is missing.
                 Unfolded it stays an icon, because the slots are right there. --}}
            {{#if collapsed}}<span class="hudtra-chip-name">{{label}}</span><span class="hudtra-count">{{count}}</span>{{/if}}
          </button>
          {{/each}}
        </span>
        {{/if}}
      </h4>
      {{/if}}

      {{!-- One loop, whether the group is sectioned or not: an unsectioned group is a
           single nameless section (see hud.mjs sectionsFor), which is what keeps the
           slot markup below from existing twice. --}}
      {{#unless collapsed}}
      <div class="hudtra-sections">
        {{#each sections}}
        {{#unless collapsed}}
        <div class="hudtra-entries" data-section="{{key}}">
          {{#each entries}}
          {{#if empty}}
          {{!-- An empty cell of the played grid. Rendered, unlike the painted field
               behind it, for one reason: something has to be there to drop an icon
               on. Only up to the end of the arrangement plus a spare column, so the
               DOM stays small (see hud.mjs gridCells). --}}
          <div class="hudtra-slot hudtra-empty" data-cell="{{cell}}"></div>
          {{else}}
          {{!-- draggable for everyone, gated in the handler: whether this user may
               arrange the bar is one answer for the whole bar (hud.mjs #editable),
               and asking it per slot in here would only put it in the markup 60
               times. Dropped on another slot the two trade places; dropped off the
               bar it offers to take the button off it. --}}
          <button type="button" class="hudtra-slot {{#if locked}}locked{{/if}} {{#if exhausted}}spent{{/if}} {{#if unavailable}}unavailable{{/if}}" data-action="{{action}}"
                  data-kind="{{kind}}" data-uuid="{{uuid}}" data-type="{{pool}}"
                  data-name="{{name}}" data-key="{{key}}" draggable="true"
                  data-tooltip-html="{{tooltipHtml}}">
            {{!-- draggable="false": an <img> is a drag source of its own, and without
                 this the browser drags the bare artwork instead of the slot. --}}
            {{#if img}}<img src="{{img}}" alt="" draggable="false">{{else}}<i class="{{icon}}"></i>{{/if}}
            {{!-- What this costs, as the shape its pool uses in the resource column.
                 In the grid it is the only thing left saying so - there is no column
                 header any more - and CSS hides it again in the grouped layout, where
                 the header already says it.

                 Two elements, not one: the shape is cut out of the inner <i> with
                 clip-path, and a clip-path would take the backing plate with it. The
                 outer span is that plate - slot art is arbitrary, and a coloured pip
                 straight on top of a bright icon is unreadable. --}}
            <span class="hudtra-cost" data-pool="{{pool}}"><i></i></span>
            {{#if locked}}<i class="hudtra-lock fa-solid fa-lock"></i>{{/if}}
            {{!-- Same icon the config dialog marks a split entry with, meaning the
                 same thing: this item has buttons in more than one pool. --}}
            {{#if split}}<i class="hudtra-split fa-solid fa-link-slash"></i>{{/if}}
            {{#if uses}}<span class="hudtra-uses">{{uses.value}}/{{uses.max}}</span>{{/if}}
            {{!-- Attacks left inside this action. Bottom-LEFT: top-left is the cost
                 marker it used to sit under, and bottom-right is the charge counter,
                 which the same slot really can carry at once (a Breath Weapon has
                 uses AND stands in for an attack). Just the number - the total is one
                 hover away, and a square wants one glyph. --}}
            {{#if attacksBadge}}<span class="hudtra-attacks">{{attacksBadge.available}}</span>{{/if}}
          </button>
          {{/if}}
          {{/each}}
        </div>
        {{/unless}}
        {{/each}}
      </div>
      {{/unless}}
    </section>
    {{/each}}
  </div>

  {{!-- BG3 puts these next to End Turn, and so do we: how tall the hotbar is, is a
       question about one person's screen. Only rendered where there is a grid to
       resize, and only the button that has somewhere left to go. --}}
  {{#if played}}
  <div class="hudtra-rows">
    <button type="button" data-action="rows" data-delta="1"
            {{#unless canAddRow}}disabled{{/unless}} data-tooltip-text="{{addRowTooltip}}">
      <i class="fa-solid fa-plus"></i>
    </button>
    <button type="button" data-action="rows" data-delta="-1"
            {{#unless canRemoveRow}}disabled{{/unless}} data-tooltip-text="{{removeRowTooltip}}">
      <i class="fa-solid fa-minus"></i>
    </button>
  </div>
  {{/if}}

  {{#if editable}}
  <div class="hudtra-controls">
    {{!-- The mark appears when detection suggests a different attack count than the
         configured one (typically after a level-up) and is cleared from inside the
         dialog. Hint only - nothing is rewritten behind the player's back. --}}
    <button type="button" class="hudtra-config-btn {{#if configNotice}}has-notice{{/if}}"
            data-action="config" data-tooltip-text="{{configTooltip}}">
      <i class="fa-solid fa-gear"></i>
      {{#if configNotice}}<i class="hudtra-config-mark fa-solid fa-exclamation"></i>{{/if}}
    </button>
    {{!-- Refilling the pools only means something where there are pools. --}}
    {{#if showEconomy}}
    <button type="button" class="hudtra-reset" data-action="reset" data-tooltip="dnd5e-hud-to-rule-them-all.resetTurn">
      <i class="fa-solid fa-rotate-left"></i>
    </button>
    {{/if}}
    {{!-- Turn control, not economy: the GM still ends a monster's turn from here.
         isMyTurn already implies being in the encounter. --}}
    {{#if isMyTurn}}
    <button type="button" class="hudtra-end-turn" data-action="endTurn" data-tooltip="dnd5e-hud-to-rule-them-all.endTurn">
      <i class="fa-solid fa-forward-step"></i>
    </button>
    {{/if}}
  </div>
  {{/if}}

  </div>

</div>

{{!-- Re-open handle for the collapsed bar. Deliberately a SECOND handle outside
     .hudtra-frame: the frame's collapse transform drags its own tab down to the
     screen edge wherever the bar happens to be centred, which is right where
     Foundry's macro bar lives. This one is positioned against the viewport's right
     corner instead, so the macro bar - visible again while the bar is away - keeps
     the middle to itself. --}}
<button type="button" class="hudtra-reopen" data-action="collapse"
        data-tooltip="dnd5e-hud-to-rule-them-all.toggleBar">
  <i class="fa-solid fa-chevron-up"></i>
</button>
{{/if}}
</div>
